<resources>
    <particlesystem x="0" y="0">
        <emitter pivotX="0.5" pivotY="0.5" type="point" attach="true">
            <particle lifetime="2">
                <imagelist>
                    <image>UI_baru/rempah/chest/chest_particle/p_kartu_rsc_area.png</image>
                </imagelist>
                <p_start>
                    <alpha min="0" max="0"/>
