                </imagelist>
                <p_start>
                    <scale pivotX="0.5" pivotY="0.5" min="0.8" max="1.2"/>
                    <velocity min="100" max="300" arahMin="-90" arahMax="-90"/>
                    <!--                    <angle pivotX="0.5" pivotY="0.5" min="0" max="0"/>-->
                    <alpha min="0" max="0"/>
                </p_start>
                <p_running>
                    <velocity min="10" max="50" when="1"/>
                    <!--                    <angle min="-360" max="360" when="1"/>-->
                    <scale min="1.2" max="2.2" when="0.4"/>
                    <scale min="0" max="0.2" when="1"/>
                    <alpha min="0.5" max="1" when="0.2"/>
                    <alpha min="0.4" max="0.8" when="0.5"/>
                    <alpha min="0" max="0" when="1"/>
                </p_running>
            </particle>
            <e_start>
                <source>
                    <point x="-130" y="-150"/>
                    <point x="130" y="200"/>
                </source>
                <burst nBurst="1" burstTime="0.01"/>
                <emit nEmit="1" delay="0.2" repeat="-1"/>
            </e_start>
            <e_running>

            </e_running>
