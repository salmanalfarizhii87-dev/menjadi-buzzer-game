            <item idItemChat="1" nextTipe="chat" nextId="2" isFromUser="false" nextTimer="1.5f" regex="waktu">Selamat %1$s, Kang.</item>
            <item idItemChat="2" nextTipe="chat" nextId="3" isFromUser="false" nextTimer="2.5f">Saya tertarik untuk membiayai bisnis kamu ke luar negeri.</item>
            <item idItemChat="3" nextTipe="chat" nextId="4" isFromUser="false" nextTimer="2.0f">Bagaimana? Tertarik?</item>
            <item idItemChat="4" nextTipe="chat" nextId="5" isFromUser="true" nextTimer="1.5f" regex="waktu">Selamat %1$s, Pak!</item>
            <item idItemChat="5" nextTipe="chat" nextId="6" isFromUser="true" nextTimer="2.5f">Wah, tentu saja Pak.</item>
            <item idItemChat="6" nextTipe="chat" nextId="7" isFromUser="true" nextTimer="2.0f">America?</item>
