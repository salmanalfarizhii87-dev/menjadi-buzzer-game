    <!--pilih cabang lain, biaya cukup-->
    <story idStory="7" showingFirst="chat#1">
        <chat>
            <item idItemChat="1" nextTipe="chat" nextId="2" isFromUser="false" nextTimer="4.0f" regex="cabang_dipilih_investor,uang_cabang_dipilih_investor">Baik. Berdasarkan catatan keuangan, total&#10;pemasukan yang kamu miliki di cabang %1$s adalah sebesar %2$s</item>
            <item idItemChat="2" nextTipe="chat" nextId="3" isFromUser="false" nextTimer="4.0f" regex="dana_tambahan_investor">Dengan ini, kamu bisa mendapatkan dana tambahan sebesar %1$s Won untuk memulai bisnis Tahu Bulat di Korea.</item>
            <item idItemChat="3" nextTipe="opsi" nextId="1" isFromUser="false" nextTimer="1.0f">Bagaimana?</item>
        </chat>
        <opsi idOpsi="1">
            <item idItemOpsi="1" nextTipe="story" nextId="9" nextTimer="2.0f">Oke Pak, Deal!</item>
            <item idItemOpsi="2" nextTipe="story" nextId="4" nextTimer="2.0f">Saya sepertinya masih butuh waktu, Pak.</item>
        </opsi>
    </story>

    <!--pilih cabang lain, kurang biaya-->
    <story idStory="8" showingFirst="chat#1">
        <chat>
            <item idItemChat="1" nextTipe="chat" nextId="2" isFromUser="false" nextTimer="3.0f" regex="cabang_dipilih_investor,uang_cabang_dipilih_investor">Hmmm.. Total penghasilan kamu di cabang %1$s baru %2$s..</item>
            <item idItemChat="2" nextTipe="chat" nextId="3" isFromUser="false" nextTimer="2.5f">Nilai bisnis kamu di sini belum cukup untuk bisa memodali kamu ke Korea.</item>
            <item idItemChat="3" nextTipe="chat" nextId="4" isFromUser="false" nextTimer="3.0f">Silahkan hubungi saya kembali setelah total&#10;penghasilan kamu di cabang ini mencapai&#10;100,000,000,000,000</item>
            <item idItemChat="4" nextTipe="opsi" nextId="1" isFromUser="false" nextTimer="2.0f">Atau kamu mau pilih cabang yang lain?</item>
        </chat>
        <opsi idOpsi="1">
            <item idItemOpsi="1" nextTipe="story" nextId="5" nextTimer="2.0f">Saya pilih cabang lain saja, Pak.</item>
