<?xml version="1.0" encoding="utf-8"?>
<resources>
    <container id="base">
        <image_list id="bannerKsatria">
            <item>ksatriatahu/ui/banner_kesatriaTahu.png</item>
        </image_list>

        <image_list id="batasMenu" alignY="bannerKsatria#1">
            <item>UI_baru/ui_batas_menu.png</item>
        </image_list>

        <container id="extra" alignY="batasMenu#1" height="200">
            <image_list id="penutupGradasi" y="171">
                <item>UI_baru/batas_gradient.png</item>
            </image_list>

            <image_list id="bgPaperClip" y="10">
                <item>UI_baru/label_paperclip_lampu_PENDEK.png</item>
            </image_list>

            <text id="textPaperClip" x="120" y="30" pivotY="0" alignX="bgPaperClip#0" alignY="bgPaperClip#0" font="comicneueLight" fontSize="30" color="000000" wrapWidth="420" isCenter="false">Pilih Resep untuk melahirkan Kesatria Tahu!</text>

            <container id="divKoin" x="15" alignX="bgPaperClip#1" y="20" alignY="bgPaperClip#0">
                <image_list id="bgBarKoin" x="10" y="5" scaleX="1.2" isBaseContainer="true">
                    <item>UI_baru/bar_peridot.png</item>
                </image_list>
                <image_list id="labelKoin">
                    <item>UI_baru/ic_koin_dalamNegeri.png</item>
                </image_list>
                <text id="textKoin" x="-10" y="0" pivotX="1" pivotY="0.5" alignX="bgBarKoin#1" alignY="bgBarKoin#0.5" font="cuckoo" fontSize="28" color="ffffff">400K</text>
            </container>

            <container id="divPeridot" x="0" alignX="divKoin#0" y="20" alignY="divKoin#1">
                <image_list id="bgBarPeridot" x="10" y="5" scaleX="1.2" isBaseContainer="true">
                    <item>UI_baru/bar_peridot.png</item>
                </image_list>
                <image_list id="labelPeridot">
                    <item>UI_baru/ic_peridot.png</item>
                </image_list>
                <!--wrapWidth="90" isCenter="false"-->
                <text id="textPeridot" x="-10" y="0" pivotX="1" pivotY="0.5" alignX="bgBarPeridot#1" alignY="bgBarPeridot#0.5" font="cuckoo" fontSize="28" color="ffffff">0</text>
            </container>
        </container>

        <scrollView id="scrollData" alignY="extra#1" x="0" y="-25" height="1000">
        </scrollView>

        <container id="contData" alignY="extra#1" x="0" y="-25" height="1000">
            <!--contresep diinit di maingame-->
            <container id="contSejarah" x="15" y="20" height="250" isVisible="false">
                <image_list id="bgSejarahAtas" x="0" y="0">
                    <item>UI_baru/lbl_kertaspita_atas.png</item>
                </image_list>
                <image_list id="bgSejarahTengah" x="0" y="0" alignY="bgSejarahAtas#1" scaleY="2.0" pivotScaleY="0">
                    <item>UI_baru/lbl_kertaspita_tengah.png</item>
                </image_list>
                <image_list id="bgSejarahBawah" x="0" y="0" alignY="bgSejarahTengah#1">
                    <item>UI_baru/lbl_kertaspita_bawah.png</item>
                </image_list>
                <text id="labelSejarah" x="30" y="10" alignX="bgSejarahAtas#0" font="cuckoo" fontSize="35" color="ffffff">Sejarah Kesatria</text>

                <container id="contIsiSejarah" x="30" y="30" alignX="bgSejarahAtas#0" alignY="labelSejarah#1">
                </container>
            </container>
        </container>

        <container id="barBackMenu" y="-137" alignY="hLayar#1" height="137">
            <image_list id="bgMenuBack" y="137" pivotY="1">
                <item>UI_baru/ui_batas_menu_back.png</item>
            </image_list>
            <button id="btnBack" x="20" imageNormal="UI_baru/btn_back.png" y="137" pivotY="1" onClick="backPressed">
            </button>

            <button id="btnTimer" x="0" pivotX="0.5" alignX="wLayar#0.5" imageNormal="UI_baru/button_hijau_lebarbesar.png" y="137" pivotY="1" isVisible="false">
                <text id="labelTimer" x="0" y="-75" pivotX="0.5" pivotY="0.5" font="cuckoo" fontSize="40" color="ffffff">00:00:00</text>
                <container id="contPeridotTimer" x="20" y="-75" pivotY="0.5" isVisible="false">
                    <image_list id="segmenTimer" x="0" y="0" pivotY="0.5">
                        <item>ksatriatahu/ui/segmen_garisHijau.png</item>
                    </image_list>
                    <image_list id="iconPeridotTimer" x="15" alignX="segmenTimer#1" y="0" pivotY="0.5">
                        <item>UI_baru/ic_peridot.png</item>
                    </image_list>
                    <text id="textPeridotTimer" x="10" y="0" alignX="iconPeridotTimer#1" pivotY="0.5" font="cuckoo" fontSize="40" color="ffffff">999</text>
                </container>
            </button>

            <button id="btnInfo" x="-20" pivotX="1" alignX="wLayar#1" imageNormal="UI_baru/button_bulat_besar_kuning.png" y="137" pivotY="1">
                <image_list id="labelInfo" x="-61" y="-78" pivotY="0.5" pivotX="0.5">
                    <item>UI_baru/ic_info.png</item>
                </image_list>
            </button>
        </container>
    </container>
</resources>
