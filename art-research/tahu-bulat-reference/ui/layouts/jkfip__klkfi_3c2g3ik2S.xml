            <dialog>Apakah kamu mau mendapatkan penjelasan lebih lanjut tentang game ini?</dialog>
            <buttons>
                <button tipe="storyXML" image="UI_baru/ui_btn_normal_merah.png" text="Tidak" analytics="OB2_TIDAK">story/tutorial_part_1_ending.xml</button>
                <button tipe="storyXML" image="UI_baru/ui_btn_normal_ijo.png" text="Tentu saja!" analytics="OB2_YA">story/tutorial_part_2.xml</button>
            </buttons>
