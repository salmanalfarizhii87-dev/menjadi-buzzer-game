            </image_list>

            <text id="labelTotal" x="0" y="10" alignX="labelSkor#0" alignY="garisplus#1" font="cuckoo" fontSize="35" color="000000">Total Skor:</text>
            <text id="textTotal" x="0" y="0" pivotX="0.5" alignX="textSkor#0.5" alignY="labelTotal#0" font="cuckoo" fontSize="100" color="000000">00000</text>
        </container>

        <container id="contTargetMinimum" x="25" y="20" alignX="contResult#0" alignY="contResult#1">
            <image_list id="bgTargetMinimum" x="3" isBaseContainer="true">
                <item>UI_baru/segmen_biru_2.png</item>
            </image_list>
            <text id="labelTargetMinimum" x="20" alignX="bgTargetMinimum#0" y="0" pivotY="0.5" alignY="bgTargetMinimum#0.5" font="cuckoo" fontSize="30" color="000000">Target Skor Minimum</text>

            <image_list id="icTargetMinimum" x="500" pivotX="1" y="0" pivotY="0.5" alignY="bgTargetMinimum#0.5">
                <item>sotong/ui/ui_bintang_1.png</item>
            </image_list>
            <text id="textTargetMinimum" x="10" alignX="icTargetMinimum#1" y="0" pivotY="0.5" alignY="bgTargetMinimum#0.5" font="cuckoo" fontSize="30" color="000000">x000</text>
        </container>

        <container id="contBestScore" x="0" y="20" alignY="contTargetMinimum#1" alignX="contTargetMinimum#0">
            <image_list id="bgBestScore" x="3" isBaseContainer="true">
                <item>UI_baru/segmen_biru_2.png</item>
            </image_list>
            <text id="labelBestScore" x="20" y="0" alignX="bgBestScore#0" pivotY="0.5" alignY="bgBestScore#0.5" font="cuckoo" fontSize="30" color="000000">Skor Terbaik</text>
            <image_list id="bestScore_bintang3" x="500" pivotX="1" y="0" pivotY="0.5" alignY="bgBestScore#0.5">
