            <text id="labelSkor" x="0" y="20" alignX="labelPelanggan#0" alignY="labelPelanggan#1" font="cuckoo" fontSize="35" color="000000">Skor</text>
            <text id="labelSisaWaktu" x="0" y="20" alignX="labelSkor#0" alignY="labelSkor#1" font="cuckoo" fontSize="35" color="000000">Sisa Waktu</text>

            <text id="textPelanggan" x="400" y="0" alignY="labelPelanggan#0" font="cuckoo" fontSize="35" color="000000">:00/00</text>
            <text id="textSkor" x="0" y="0" alignX="textPelanggan#0" alignY="labelSkor#0" font="cuckoo" fontSize="35" color="000000">:000</text>
