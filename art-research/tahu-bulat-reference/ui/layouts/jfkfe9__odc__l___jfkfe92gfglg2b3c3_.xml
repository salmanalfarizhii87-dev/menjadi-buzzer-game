            </image_list>
            <text id="textBestScore" x="10" alignX="bestScore_bintang3#1" y="0" pivotY="0.5" alignY="bgBestScore#0.5" font="cuckoo" fontSize="30" color="000000">000</text>
        </container>

        <text id="textTips" x="-20" pivotX="0.5" alignX="wLayar#0.5" y="20" alignY="contBestScore#1" font="cuckoo" fontSize="30" color="000000" wrapWidth="500" isCenter="true">Capai target skor minimum untuk menyelesaikan level ini.</text>

