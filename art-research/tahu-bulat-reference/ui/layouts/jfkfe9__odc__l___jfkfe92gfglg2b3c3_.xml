        <container id="contLevel" x="25" y="0">
            <image_list id="bgLevel" x="3" isBaseContainer="true">
                <item>UI_baru/segmen_biru_2.png</item>
            </image_list>
            <text id="labelLevel" x="0" y="5" pivotX="0.5" alignX="bgLevel#0.5" alignY="bgLevel#0" font="cuckoo" fontSize="35" color="ffffff">Bandung - 00</text>
