                <image id="img_spinner3" path="spinner/UI_wheel_1.png" pivotX="0.5" pivotY="1.05" rotation="120" pivotRotateX="0.5" pivotRotateY="1.05">
                    <image id="img_icon3" path="UI_baru/fever_tabul.png" pivotX="0.5" pivotY="0.5" y="-170" scaleX="0.5" scaleY="0.5" pivotScaleX="0.5" pivotScaleY="0.5"/>
